        "content_sha256": null
      }
    },
    {
      "system_id": "personnel-service-law",
      "article_number": "9",
      "current_text": "يجوز للوزير الاعفاء من شرط وأكثر من شروط الترقية الواردة في هذا النظام عدا شرط المدة وتوفر الشاغر.",
      "previous_texts": [],
